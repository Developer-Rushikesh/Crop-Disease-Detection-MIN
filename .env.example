# ==============================================================================
# FloraScan AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development and fill in the values.
# NEVER commit the actual .env file with production credentials to GitHub.

# Django Security Settings
DJANGO_SECRET_KEY=replace-this-with-a-secure-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Model & Inference Settings (Optional Overrides)
FLORASCAN_MODEL_TYPE=tflite
FLORASCAN_CONFIDENCE_THRESHOLD=55.0

# Optional Database Configuration (Defaults to SQLite if omitted)
# DATABASE_URL=postgres://user:password@localhost:5432/florascan_db

